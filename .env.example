# Copy to .env and fill in. Never commit .env.

# DeepSeek key, used by the vision model that describes each image.
DEEPSEEK_API_KEY=
# TypeSafe AI key, used by Jev to pick the winning image.
TYPESAFE_API_KEY=

# Optional overrides (defaults shown).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_VISION_MODEL=deepseek-flash
# TYPESAFE_DECISION_MODEL=jev-latest
# IMAGE_SELECTOR_MEMORY_FILE=image_selector_memory.jsonl
